# --- Hostname canonicalization -------------------------------------------
# Rewrites short names to FQDNs, then re-parses, so `ssh ms-01` and
# `ssh ms-01.lan.lovelett.me` get identical config.
CanonicalizeHostname yes
CanonicalDomains lan.lovelett.me
CanonicalizeFallbackLocal yes
CanonicalizeMaxDots 1

# --- Per-host overrides (must precede the wildcards) ---------------------
Host share.lan.lovelett.me home-assistant.lan.lovelett.me
  User rlovelett

Host proxy.lan.lovelett.me
  Port 2222

Host rss.lan.lovelett.me
  ForwardAgent yes

# --- Domain default ------------------------------------------------------
# Everything in lan.lovelett.me logs in as root; HostName defaults to the
# canonicalized name, so no per-host HostName lines are needed.
Host 192.168.*.* *.lan.lovelett.me
  User root

# --- Global defaults -----------------------------------------------------
Host *
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
